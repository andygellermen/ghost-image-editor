{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.4.0",
  "manifest_version": 3,
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/ghost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ghost-image-editor@example.com",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/ghost/*"],
      "js": ["lib/cropper.min.js", "content.js", "editor.js"],
      "css": ["editor.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
