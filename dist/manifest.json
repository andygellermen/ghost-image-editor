{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "0.5.3",
  "manifest_version": 3,
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/ghost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/ghost/*"
      ],
      "js": [
        "content.js",
        "editor.js"
      ],
      "css": [
        "editor.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/ghost-img-editor-16px.png",
    "48": "icons/ghost-img-editor-48px.png",
    "96": "icons/ghost-img-editor-96px.png",
    "128": "icons/ghost-img-editor-128px.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ghost-image-editor@ghost.local",
      "strict_min_version": "109.0"
    }
  }
}
